{
  "name": "grove",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter @grove/web dev",
    "build": "pnpm --filter @grove/web build",
    "preview": "pnpm --filter @grove/web preview",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  }
}

