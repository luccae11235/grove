# Absolute public origin used by canonical URLs, RSS, sitemap, and social metadata.
SITE_URL=https://example.com

# Optional path prefix for repository-based GitHub Pages deployments.
BASE_PATH=/

# Drafts are already visible in local development. Use this only for an explicit
# production-mode preview that should include draft entries.
SHOW_DRAFTS=false

# Public newsletter API URL embedded into the static signup form at build time.
PUBLIC_NEWSLETTER_API_URL=https://newsletter-api.example.com
# Required alongside the API URL; signup stays disabled without it.
PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@example.com

# Physical sender address required in newsletter email footers.
NEWSLETTER_POSTAL_ADDRESS=Your legal mailing address

# Newsletter API runtime (Railway newsletter-api service).
DATABASE_URL=postgresql://user:password@host:5432/database
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
RESEND_SEGMENT_ID=seg_...
# Optional until Grove has more than one email preference stream.
RESEND_TOPIC_ID=
NEWSLETTER_FROM=Grove <newsletter@example.com>
NEWSLETTER_REPLY_TO=hello@example.com
WEB_URL=https://example.com
API_PUBLIC_URL=https://newsletter-api.example.com
ALLOWED_ORIGINS=https://example.com
EVENT_HASH_SALT=replace-with-at-least-16-random-characters
CONFIRMATION_TTL_HOURS=48
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=900
