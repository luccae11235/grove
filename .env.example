# Absolute public origin used by canonical URLs, RSS, sitemap, and social metadata.
SITE_URL=https://example.com

# Optional path prefix for repository-based GitHub Pages deployments.
BASE_PATH=/

# Drafts are already visible in local development. Use this only for an explicit
# production-mode preview that should include draft entries.
SHOW_DRAFTS=false

# Use pnpm build:static for GitHub Pages: it forces this profile on, disables
# all runtime integrations and excludes drafts regardless of inherited flags.
PUBLIC_STATIC_SITE=false

# Public newsletter API URL embedded into the static signup form at build time.
PUBLIC_NEWSLETTER_API_URL=https://newsletter-api.example.com
# Required alongside the API URL; signup stays disabled without it.
PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@example.com

# Optional first-party measurement client. Keep disabled until the matching
# observability service, privacy notice, and exact-origin CORS are verified.
PUBLIC_OBSERVABILITY_ENABLED=false
PUBLIC_OBSERVABILITY_API_URL=https://observe.example.com
PUBLIC_OBSERVABILITY_CONSENT_VERSION=2026-07

# Physical sender address required in newsletter email footers.
NEWSLETTER_POSTAL_ADDRESS=Your legal mailing address

# Newsletter API runtime (Railway newsletter-api service).
DATABASE_URL=postgresql://user:password@host:5432/database
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
RESEND_SEGMENT_ID=seg_...
# Optional until Grove has more than one email preference stream.
RESEND_TOPIC_ID=
# Optional in production. When set, confirmation messages, contact activation,
# and broadcast recipients are restricted to these comma-separated addresses.
NEWSLETTER_RECIPIENT_ALLOWLIST=
# Public signup is an explicit launch switch. Keep false while an allowlist is
# required; set true only when signups are intentionally open to everyone.
NEWSLETTER_PUBLIC_SIGNUP=false
NEWSLETTER_FROM=Grove <newsletter@example.com>
# Optional dedicated identity for confirmations and subscription-management
# messages. Verify its sending subdomain separately before enabling it.
NEWSLETTER_TRANSACTIONAL_FROM=Grove <confirm@confirm.example.com>
NEWSLETTER_REPLY_TO=hello@example.com
WEB_URL=https://example.com
API_PUBLIC_URL=https://newsletter-api.example.com
ALLOWED_ORIGINS=https://example.com
EVENT_HASH_SALT=replace-with-at-least-16-random-characters
OBSERVABILITY_LINK_SECRET=replace-with-at-least-32-random-characters
DEPLOYMENT_ENV=production
CONFIRMATION_TTL_HOURS=48
# Website management/unsubscribe links are shorter lived than opt-in links.
SUBSCRIPTION_ACTION_TTL_HOURS=24
# Per-address cooldown for confirmation retries and management emails.
SUBSCRIPTION_RESEND_COOLDOWN_SECONDS=60
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=900

# Observability API runtime also uses DATABASE_URL, ALLOWED_ORIGINS,
# DEPLOYMENT_ENV, and the same-environment OBSERVABILITY_LINK_SECRET.
CONSENT_VERSION=2026-07
