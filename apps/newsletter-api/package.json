{
  "name": "@grove/newsletter-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "broadcast": "tsx src/cli/broadcast.ts",
    "report": "tsx src/cli/report.ts",
    "retention": "tsx src/cli/retention.ts",
    "prove:staging": "tsx src/cli/proveStaging.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "hono": "^4.12.30",
    "postgres": "^3.4.9",
    "resend": "^6.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
