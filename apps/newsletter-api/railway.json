{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/apps/newsletter-api/Dockerfile"
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @grove/newsletter-api migrate"],
    "startCommand": "pnpm --filter @grove/newsletter-api start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
