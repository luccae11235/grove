FROM node:22-alpine AS build

RUN apk add --no-cache python3
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

ARG SITE_URL
ARG BASE_PATH=/
ARG SHOW_DRAFTS=false
ARG PUBLIC_NEWSLETTER_API_URL
ARG PUBLIC_PRIVACY_CONTACT_EMAIL
ARG PUBLIC_OBSERVABILITY_ENABLED=false
ARG PUBLIC_OBSERVABILITY_API_URL
ARG PUBLIC_OBSERVABILITY_CONSENT_VERSION=2026-07
ARG PUBLIC_FEEDBACK_ENABLED=false
ARG NEWSLETTER_POSTAL_ADDRESS
ARG RAILWAY_GIT_COMMIT_SHA=development
ENV SITE_URL=$SITE_URL
ENV BASE_PATH=$BASE_PATH
ENV SHOW_DRAFTS=$SHOW_DRAFTS
ENV PUBLIC_NEWSLETTER_API_URL=$PUBLIC_NEWSLETTER_API_URL
ENV PUBLIC_PRIVACY_CONTACT_EMAIL=$PUBLIC_PRIVACY_CONTACT_EMAIL
ENV PUBLIC_OBSERVABILITY_ENABLED=$PUBLIC_OBSERVABILITY_ENABLED
ENV PUBLIC_OBSERVABILITY_API_URL=$PUBLIC_OBSERVABILITY_API_URL
ENV PUBLIC_OBSERVABILITY_CONSENT_VERSION=$PUBLIC_OBSERVABILITY_CONSENT_VERSION
ENV PUBLIC_FEEDBACK_ENABLED=$PUBLIC_FEEDBACK_ENABLED
ENV NEWSLETTER_POSTAL_ADDRESS=$NEWSLETTER_POSTAL_ADDRESS
ENV RELEASE_SHA=$RAILWAY_GIT_COMMIT_SHA
RUN pnpm build

FROM caddy:2.10-alpine
COPY apps/web/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv
