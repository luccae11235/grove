:{$PORT:8080} {
  root * /srv
  encode zstd gzip

  @immutable path /_astro/*
  header @immutable Cache-Control "public, max-age=31536000, immutable"
  @revalidatable not path /_astro/*
  header @revalidatable Cache-Control "no-cache"
  @releaseIdentity path /version.json
  header @releaseIdentity Cache-Control "no-store"
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
  }

  @www host www.aflora.page
  redir @www https://aflora.page{uri} permanent

  @article_without_trailing_slash path_regexp article_without_trailing_slash ^/(?:pt-br/)?learn/[^/]+$
  redir @article_without_trailing_slash {http.request.uri.path}/ 308

  try_files {path} {path}/index.html
  file_server

  handle_errors {
    rewrite * /404.html
    file_server
  }
}
