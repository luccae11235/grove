---
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
  contentType: "page" | "article" | "issue";
  contentId?: string;
}

const { locale, contentType, contentId } = Astro.props;
const enabled = import.meta.env.PUBLIC_OBSERVABILITY_ENABLED === "true";
const apiBase = import.meta.env.PUBLIC_OBSERVABILITY_API_URL?.replace(/\/$/, "") ?? "";
const consentVersion = import.meta.env.PUBLIC_OBSERVABILITY_CONSENT_VERSION?.trim() || "2026-07";
if (enabled && !apiBase) {
  throw new Error("PUBLIC_OBSERVABILITY_API_URL is required when observability is enabled.");
}
if (apiBase) {
  const url = new URL(apiBase);
  const local = ["localhost", "127.0.0.1"].includes(url.hostname);
  if (url.protocol !== "https:" && !local) {
    throw new Error("PUBLIC_OBSERVABILITY_API_URL must use HTTPS outside local development.");
  }
}
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const privacyHref = locale === "pt-BR" ? `${base}/pt-br/privacy` : `${base}/privacy`;
const copy = locale === "pt-BR"
  ? {
      title: "A medição é opcional.",
      description:
        "Com sua permissão, o Grove registra páginas vistas, tempo de leitura ativo, progresso e uso dos laboratórios. Não gravamos textos digitados, endereço de rede ou replay da sessão.",
      accept: "Aceitar medição",
      reject: "Recusar",
      privacy: "Ver detalhes de privacidade",
      settings: "Configurações de medição",
    }
  : {
      title: "Measurement is optional.",
      description:
        "With your permission, Grove records pages viewed, active reading time, progress, and lab use. We do not store typed text, network addresses, or session replay.",
      accept: "Accept measurement",
      reject: "Reject",
      privacy: "Read privacy details",
      settings: "Measurement settings",
    };
---

{enabled && (
  <>
    <button
      type="button"
      class="analytics-settings"
      data-analytics-settings
      aria-controls="analytics-consent"
      aria-expanded="false"
    >{copy.settings}</button>
    <section
      id="analytics-consent"
      class="analytics-consent"
      data-analytics-consent
      data-api-base={apiBase}
      data-consent-version={consentVersion}
      data-locale={locale}
      data-content-type={contentType}
      data-content-id={contentId}
      aria-labelledby="analytics-consent-title"
      role="dialog"
      hidden
    >
      <div>
        <strong id="analytics-consent-title">{copy.title}</strong>
        <p>{copy.description} <a href={privacyHref}>{copy.privacy}</a>.</p>
      </div>
      <div class="analytics-consent-actions">
        <button type="button" data-analytics-accept>{copy.accept}</button>
        <button type="button" data-analytics-reject>{copy.reject}</button>
      </div>
    </section>
    <script>
      import { initializeObservability } from "../scripts/observability";

      const banner = document.querySelector<HTMLElement>("[data-analytics-consent]");
      const settingsButton = document.querySelector<HTMLButtonElement>("[data-analytics-settings]");
      if (banner && settingsButton) {
        initializeObservability({
          apiBase: banner.dataset.apiBase ?? "",
          consentVersion: banner.dataset.consentVersion ?? "",
          locale: banner.dataset.locale === "pt-BR" ? "pt-BR" : "en",
          contentType: banner.dataset.contentType === "article"
            ? "article"
            : banner.dataset.contentType === "issue"
              ? "issue"
              : "page",
          contentId: banner.dataset.contentId || undefined,
          banner,
          settingsButton,
        });
      }
    </script>
  </>
)}
