---
import type { Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const apiBase = import.meta.env.PUBLIC_NEWSLETTER_API_URL?.replace(/\/$/, "") ?? "";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const invalidHref = locale === "pt-BR"
  ? `${base}/pt-br/newsletter/confirmed?status=invalid`
  : `${base}/newsletter/confirmed?status=invalid`;
const copy = locale === "pt-BR"
  ? {
      eyebrow: "Confirmação da newsletter",
      title: "Confirme sua inscrição",
      message: "Para receber a newsletter da Aflora, confirme sua inscrição no botão abaixo.",
      manual: "Confirmar inscrição",
    }
  : {
      eyebrow: "Newsletter confirmation",
      title: "Confirm your subscription",
      message: "To receive Aflora’s newsletter, confirm your subscription using the button below.",
      manual: "Confirm subscription",
    };
---

<header
  class="newsletter-confirmation newsletter-confirmation-progress"
  data-confirmation-progress
  data-api-base={apiBase}
  data-invalid-href={invalidHref}
>
  <p class="eyebrow">{copy.eyebrow}</p>
  <h1>{copy.title}</h1>
  <p class="lede">{copy.message}</p>
  <form method="post" action={`${apiBase}/v1/subscriptions/confirm`} data-confirmation-form>
    <input type="hidden" name="token" />
    <button type="submit" class="button-link" disabled>{copy.manual}</button>
  </form>
  <noscript>{locale === "pt-BR" ? "Ative o JavaScript para confirmar sua inscrição." : "Enable JavaScript to confirm your subscription."}</noscript>
</header>

<script>
  document.querySelectorAll<HTMLElement>("[data-confirmation-progress]").forEach((panel) => {
    const apiBase = panel.dataset.apiBase;
    const invalidHref = panel.dataset.invalidHref ?? "/newsletter/confirmed?status=invalid";
    const token = new URLSearchParams(window.location.search).get("token");
    const form = panel.querySelector<HTMLFormElement>("[data-confirmation-form]");

    if (!apiBase || !token || token.length > 200) {
      window.location.replace(invalidHref);
      return;
    }

    const input = form?.querySelector<HTMLInputElement>('input[name="token"]');
    const button = form?.querySelector<HTMLButtonElement>('button');
    if (input && button) {
      input.value = token;
      button.disabled = false;
    }
  });
</script>
