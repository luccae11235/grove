<figure class="markov-synthesis" data-markov-synthesis>
  <div
    class="synthesis-frame"
    role="group"
    aria-label="Three examples of missing Markov state"
    aria-describedby="markov-synthesis-description"
  >
    <p id="markov-synthesis-description" class="sr-only">
      Pong is missing dynamics, repaired by adding velocity to position. The
      door-and-key environment is missing memory, repaired by adding whether
      the agent has the key. The checkpoint environment is missing reward
      state, repaired by adding the next required checkpoint.
    </p>

    <div class="repairs">
      <section class="repair">
        <div class="scene pong-scene" aria-hidden="true">
          <span class="center-line"></span>
          <span class="ball"></span>
          <span class="motion-arrow">↘</span>
          <span class="paddle"></span>
        </div>
        <p class="example-name">Pong</p>
        <h3>Missing dynamics</h3>
        <div class="state-repair">
          <span class="base-state">position</span>
          <span class="plus" aria-hidden="true">+</span>
          <strong>velocity</strong>
        </div>
      </section>

      <section class="repair">
        <div class="scene door-scene" aria-hidden="true">
          <span class="agent"></span>
          <span class="route"></span>
          <span class="key"><i></i><b></b></span>
          <span class="door"><i></i></span>
        </div>
        <p class="example-name">Key–Door</p>
        <h3>Missing memory</h3>
        <div class="state-repair">
          <span class="base-state">position</span>
          <span class="plus" aria-hidden="true">+</span>
          <strong>has key</strong>
        </div>
      </section>

      <section class="repair">
        <div class="scene checkpoint-scene" aria-hidden="true">
          <span class="hub">Hub</span>
          <span class="path path-a"></span>
          <span class="path path-b"></span>
          <span class="path path-c"></span>
          <span class="checkpoint checkpoint-a">A</span>
          <span class="checkpoint checkpoint-b">B</span>
          <span class="checkpoint checkpoint-c">C</span>
        </div>
        <p class="example-name">Checkpoints</p>
        <h3>Missing reward state</h3>
        <div class="state-repair">
          <span class="base-state">position</span>
          <span class="plus" aria-hidden="true">+</span>
          <strong>next checkpoint</strong>
        </div>
      </section>
    </div>
  </div>

  <p class="figure-note">
    A sufficient state does not remember everything. It keeps the smallest
    summary of the past that can still change what happens next.
  </p>
</figure>

