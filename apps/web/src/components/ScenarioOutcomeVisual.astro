---
interface Counts {
  green: number;
  red: number;
}

interface Props {
  locale?: "en" | "pt-BR";
  label: string;
  predictedRed: Counts;
  predictedGreen: Counts;
}

const { locale = "en", label, predictedRed, predictedGreen } = Astro.props;
const copy = locale === "pt-BR"
  ? {
      predictedRed: "Previu vermelho",
      predictedGreen: "Previu verde",
      actualGreen: "Verde real",
      actualRed: "Vermelho real",
    }
  : {
      predictedRed: "Predicted red",
      predictedGreen: "Predicted green",
      actualGreen: "Actual green",
      actualRed: "Actual red",
    };

for (const [region, counts] of Object.entries({ predictedRed, predictedGreen })) {
  for (const [actual, count] of Object.entries(counts)) {
    if (!Number.isInteger(count) || count < 0 || count > 100) {
      throw new Error(`${region}.${actual} must be an integer between 0 and 100.`);
    }
  }
}

function placeDots(counts: Counts, centerX: number, rotation: number) {
  const total = counts.green + counts.red;
  let greenPlaced = 0;
  return Array.from({ length: total }, (_, index) => {
    const expectedGreen = Math.round(((index + 1) * counts.green) / total);
    const actual = expectedGreen > greenPlaced ? "green" : "red";
    if (actual === "green") greenPlaced += 1;
    const radius = total === 1 ? 0 : 72 * Math.sqrt((index + 0.45) / total);
    const angle = rotation + index * Math.PI * (3 - Math.sqrt(5));
    return { actual, x: centerX + Math.cos(angle) * radius, y: 166 + Math.sin(angle) * radius };
  });
}

const redDots = placeDots(predictedRed, 190, -0.5);
const greenDots = placeDots(predictedGreen, 530, 0.35);
const summary = locale === "pt-BR"
  ? `${label}. Previu vermelho: ${predictedRed.green} verdes reais e ${predictedRed.red} vermelhos reais. Previu verde: ${predictedGreen.green} verdes reais e ${predictedGreen.red} vermelhos reais.`
  : `${label}. Predicted red: ${predictedRed.green} actual green and ${predictedRed.red} actual red. Predicted green: ${predictedGreen.green} actual green and ${predictedGreen.red} actual red.`;
---

<figure class="scenario-outcome" data-scenario-outcome data-label={label}>
  <svg viewBox="0 0 720 280" role="img" aria-label={summary}>
    <g class="model" aria-hidden="true">
      <rect x="308" y="12" width="104" height="34" rx="9" />
      <text x="360" y="34" text-anchor="middle">{label}</text>
    </g>
    <g class="arrows" aria-hidden="true">
      <path d="M330 46C310 63 292 75 274 88" />
      <path d="M284 86L274 88L279 78" />
      <path d="M390 46C410 63 428 75 446 88" />
      <path d="M436 86L446 88L441 78" />
    </g>
    <g class="region predicted-red" aria-hidden="true">
      <circle class="disc" cx="190" cy="166" r="92" />
      {redDots.map((dot) => <circle class={`dot actual-${dot.actual}`} cx={dot.x} cy={dot.y} r="4" />)}
      <text x="190" y="270" text-anchor="middle">{copy.predictedRed}</text>
    </g>
    <g class="region predicted-green" aria-hidden="true">
      <circle class="disc" cx="530" cy="166" r="92" />
      {greenDots.map((dot) => <circle class={`dot actual-${dot.actual}`} cx={dot.x} cy={dot.y} r="4" />)}
      <text x="530" y="270" text-anchor="middle">{copy.predictedGreen}</text>
    </g>
  </svg>
  <figcaption>
    <span><i class="green"></i>{copy.actualGreen}</span>
    <span><i class="red"></i>{copy.actualRed}</span>
  </figcaption>
</figure>

<style>
  .scenario-outcome {
    --green: var(--accent);
    --green-dark: var(--accent-hover);
    --red: #b44332;
    width: min(560px, 100%);
    margin: 24px auto 30px;
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface-raised);
    box-shadow: 0 12px 34px rgb(22 56 43 / 6%);
  }
  svg { display: block; width: 100%; height: auto; }
  .model rect { fill: var(--surface-subtle); stroke: var(--ink); stroke-width: 1.4; }
  .model text, .region text { fill: var(--text); font-family: Inter, ui-sans-serif, system-ui, sans-serif; font-weight: 700; }
  .model text { font-size: 12px; }
  .region text { font-size: 14px; }
  .arrows path { fill: none; stroke: var(--ink); stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; }
  .disc { stroke-width: 1.8; }
  .predicted-red .disc { fill: color-mix(in srgb, var(--red) 3%, var(--surface-raised)); stroke: var(--red); }
  .predicted-green .disc { fill: color-mix(in srgb, var(--green) 4%, var(--surface-raised)); stroke: var(--green); }
  .predicted-red text { fill: var(--red); }
  .predicted-green text { fill: var(--green-dark); }
  .dot { stroke-width: 1.45; }
  .actual-green { fill: color-mix(in srgb, var(--green) 22%, var(--surface-raised)); stroke: var(--green-dark); }
  .actual-red { fill: color-mix(in srgb, var(--red) 5%, var(--surface-raised)); stroke: var(--red); }
  figcaption { display: flex; justify-content: center; gap: 20px; border-top: 1px solid var(--border); padding: 9px 14px; background: var(--surface-subtle); font: 650 11px/1.4 Inter, ui-sans-serif, system-ui, sans-serif; }
  figcaption span { display: inline-flex; align-items: center; gap: 6px; }
  figcaption i { width: 9px; height: 9px; border: 1.5px solid; border-radius: 50%; }
  figcaption .green { border-color: var(--green-dark); background: color-mix(in srgb, var(--green) 22%, var(--surface-raised)); }
  figcaption .red { border-color: var(--red); background: color-mix(in srgb, var(--red) 5%, var(--surface-raised)); }
</style>
