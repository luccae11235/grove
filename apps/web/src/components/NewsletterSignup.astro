---
import type { Locale } from "../i18n";

interface Props {
  locale?: Locale;
  source?: string;
  compact?: boolean;
}

const { locale = "en", source = "website", compact = false } = Astro.props;
const staticSite = import.meta.env.PUBLIC_STATIC_SITE === "true";
const apiBase = staticSite ? "" : (import.meta.env.PUBLIC_NEWSLETTER_API_URL?.replace(/\/$/, "") ?? "");
const privacyContact = import.meta.env.PUBLIC_PRIVACY_CONTACT_EMAIL?.trim() ?? "";
if (apiBase && !privacyContact) {
  throw new Error("PUBLIC_PRIVACY_CONTACT_EMAIL is required when newsletter signup is enabled.");
}
if (privacyContact && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(privacyContact)) {
  throw new Error("PUBLIC_PRIVACY_CONTACT_EMAIL must be a valid email address.");
}
if (apiBase) {
  const apiUrl = new URL(apiBase);
  const isLocal = ["localhost", "127.0.0.1"].includes(apiUrl.hostname);
  if (apiUrl.protocol !== "https:" && !isLocal) {
    throw new Error("PUBLIC_NEWSLETTER_API_URL must use HTTPS outside local development.");
  }
}
const endpoint = apiBase && privacyContact ? `${apiBase}/v1/subscriptions` : "";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const privacyHref = locale === "pt-BR" ? `${base}/pt-br/privacy` : `${base}/privacy`;
const manageHref = locale === "pt-BR"
  ? `${base}/pt-br/newsletter/manage`
  : `${base}/newsletter/manage`;
const copy = locale === "pt-BR"
  ? {
      eyebrow: "Uma ideia difícil por semana",
      title: "Receba a Aflora no seu e-mail.",
      description:
        "Um artigo visual, o experimento principal e uma pergunta para levar com você. Confirmação em duas etapas; você pode sair quando quiser.",
      email: "Seu melhor e-mail",
      placeholder: "voce@exemplo.com",
      submit: "Quero receber",
      unavailable: "As inscrições serão abertas assim que o serviço de newsletter estiver conectado.",
      submitting: "Enviando…",
      success: "Confira sua caixa de entrada. Enviamos a confirmação ou o status atual da inscrição. Se nada chegar, tente novamente em um minuto.",
      successButton: "Enviar novamente",
      retrying: "Enviar novamente em",
      error: "Não foi possível iniciar sua inscrição. Tente novamente em instantes.",
      consent: "Ao continuar, você solicita os e-mails semanais da Aflora. A inscrição só fica ativa depois da confirmação.",
      privacy: "Privacidade e uso de dados",
      manage: "Já está na lista? Gerencie ou cancele sua inscrição",
    }
  : {
      eyebrow: "One difficult idea each week",
      title: "Get Aflora in your inbox.",
      description:
        "One visual article, its central experiment, and a question worth carrying forward. Double opt-in; leave whenever you want.",
      email: "Your email address",
      placeholder: "you@example.com",
      submit: "Subscribe",
      unavailable: "Subscriptions will open as soon as the newsletter service is connected.",
      submitting: "Sending…",
      success: "Check your inbox. We sent either a confirmation or your current subscription status. If nothing arrives, try again in one minute.",
      successButton: "Send again",
      retrying: "Send again in",
      error: "We could not start your subscription. Please try again in a moment.",
      consent: "By continuing, you request Aflora's weekly emails. Your subscription becomes active only after confirmation.",
      privacy: "Privacy and data use",
      manage: "Already on the list? Manage or unsubscribe",
    };
---
{!staticSite && (<>

<section class:list={["newsletter-signup", { compact }]} aria-labelledby={`newsletter-signup-${source}`}>
  <div class="newsletter-signup-copy">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id={`newsletter-signup-${source}`}>{copy.title}</h2>
    <p>{copy.description}</p>
  </div>
  <form data-newsletter-signup data-endpoint={endpoint} novalidate>
    <label>
      <span>{copy.email}</span>
      <input
        type="email"
        name="email"
        inputmode="email"
        autocomplete="email"
        placeholder={copy.placeholder}
        required
        disabled={!endpoint}
      />
    </label>
    <label class="newsletter-honeypot" aria-hidden="true">
      Website
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
    <input type="hidden" name="locale" value={locale} />
    <input type="hidden" name="source" value={source} />
    <button
      type="submit"
      disabled={!endpoint}
      data-default-label={copy.submit}
      data-success-label={copy.successButton}
      data-retrying-label={copy.retrying}
    >{copy.submit}</button>
    <p
      class="newsletter-form-status"
      data-status
      data-unavailable={copy.unavailable}
      data-submitting={copy.submitting}
      data-success={copy.success}
      data-error={copy.error}
      role="status"
      aria-live="polite"
    >{!endpoint && copy.unavailable}</p>
    <p class="newsletter-consent">{copy.consent} <a href={privacyHref}>{copy.privacy}</a>.</p>
    <p class="newsletter-manage-link"><a href={manageHref}>{copy.manage} →</a></p>
  </form>
</section>

</>)}
<script>
  document.querySelectorAll<HTMLFormElement>("[data-newsletter-signup]").forEach((form) => {
    if (form.dataset.bound === "true") return;
    form.dataset.bound = "true";
    const endpoint = form.dataset.endpoint;
    const status = form.querySelector<HTMLElement>("[data-status]");
    const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
    if (!endpoint || !status || !button) return;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      window.groveAnalytics?.track("newsletter_signup_submitted", {
        source: form.querySelector<HTMLInputElement>("input[name='source']")?.value ?? "website",
      });
      const payload = Object.fromEntries(new FormData(form).entries());
      const query = new URLSearchParams(window.location.search);
      for (const [parameter, field] of [
        ["utm_source", "utmSource"],
        ["utm_medium", "utmMedium"],
        ["utm_campaign", "utmCampaign"],
      ] as const) {
        const value = query.get(parameter);
        if (value) payload[field] = value;
      }
      button.disabled = true;
      button.textContent = status.dataset.submitting ?? "";
      button.dataset.state = "loading";
      button.setAttribute("aria-busy", "true");
      form.setAttribute("aria-busy", "true");
      status.textContent = status.dataset.submitting ?? "";
      status.dataset.state = "loading";

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error(`Subscription failed with ${response.status}`);
        form.reset();
        window.groveAnalytics?.track("newsletter_signup_accepted", {
          source: String(payload.source ?? "website"),
        });
        status.textContent = status.dataset.success ?? "";
        status.dataset.state = "success";
        const retryingLabel = button.dataset.retryingLabel ?? "";
        button.dataset.state = "success";
        let remaining = 60;
        button.textContent = `${retryingLabel} ${remaining}s`;
        const countdown = window.setInterval(() => {
          remaining -= 1;
          if (remaining > 0) {
            button.textContent = `${retryingLabel} ${remaining}s`;
            return;
          }
          window.clearInterval(countdown);
          button.textContent = button.dataset.successLabel ?? "";
          button.disabled = false;
        }, 1_000);
      } catch {
        status.textContent = status.dataset.error ?? "";
        status.dataset.state = "error";
        button.textContent = button.dataset.defaultLabel ?? "";
        delete button.dataset.state;
        button.disabled = false;
      } finally {
        button.removeAttribute("aria-busy");
        form.removeAttribute("aria-busy");
      }
    });
  });
</script>
