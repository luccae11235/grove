---
import { MarkovPongPlayground } from "@grove/tree-visuals";

interface Props {
  locale?: "en" | "pt-BR";
  mode: "position" | "velocity";
}

const { mode, locale = "en" } = Astro.props;
---

<div data-analytics-lab={`markov-pong-${mode}`}>
  <MarkovPongPlayground mode={mode} locale={locale} client:load />
</div>
