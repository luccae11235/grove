---
import {
  CheckpointAlignedPlayground,
  CheckpointLab,
  CheckpointProxyPlayground,
  OptimalCheckpointTrajectory,
  SensorAlignedPlayground,
  SensorLab,
  SensorProxyPlayground,
  TrafficAlignedPlayground,
  TrafficLab,
  TrafficProxyPlayground,
} from "@grove/tree-visuals";
import type { Locale } from "../i18n";

interface Props {
  kind:
    | "checkpoint-optimal"
    | "checkpoint-proxy"
    | "checkpoint-aligned"
    | "checkpoint"
    | "checkpoint-editable"
    | "sensor-proxy"
    | "sensor-aligned"
    | "sensor"
    | "traffic-proxy"
    | "traffic-aligned"
    | "traffic";
  locale?: Locale;
}

const { kind, locale = "en" } = Astro.props;
---

<div data-analytics-lab={`reward-hacking-${kind}`}>
  {kind === "checkpoint-optimal" ? (
    <OptimalCheckpointTrajectory client:load locale={locale} />
  ) : kind === "checkpoint-proxy" ? (
    <CheckpointProxyPlayground client:load locale={locale} />
  ) : kind === "checkpoint-aligned" ? (
    <CheckpointAlignedPlayground client:load locale={locale} />
  ) : kind === "checkpoint" ? (
    <CheckpointLab client:load locale={locale} />
  ) : kind === "checkpoint-editable" ? (
    <CheckpointLab client:load locale={locale} editable />
  ) : kind === "sensor-proxy" ? (
    <SensorProxyPlayground client:load locale={locale} />
  ) : kind === "sensor-aligned" ? (
    <SensorAlignedPlayground client:load locale={locale} />
  ) : kind === "sensor" ? (
    <SensorLab client:load locale={locale} />
  ) : kind === "traffic-proxy" ? (
    <TrafficProxyPlayground client:load locale={locale} />
  ) : kind === "traffic-aligned" ? (
    <TrafficAlignedPlayground client:load locale={locale} />
  ) : (
    <TrafficLab client:load locale={locale} />
  )}
</div>
