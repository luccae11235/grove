---
import {
  CheckpointLab,
  CheckpointProxyPlayground,
  OptimalCheckpointTrajectory,
  SensorLab,
  TrafficLab,
} from "@grove/tree-visuals";
import type { Locale } from "../i18n";

interface Props {
  kind:
    | "checkpoint-optimal"
    | "checkpoint-proxy"
    | "checkpoint"
    | "checkpoint-editable"
    | "sensor"
    | "traffic";
  locale?: Locale;
}

const { kind, locale = "en" } = Astro.props;
---

<div data-analytics-lab={`reward-hacking-${kind}`}>
  {kind === "checkpoint-optimal" ? (
    <OptimalCheckpointTrajectory client:load />
  ) : kind === "checkpoint-proxy" ? (
    <CheckpointProxyPlayground client:load />
  ) : kind === "checkpoint" ? (
    <CheckpointLab client:load locale={locale} />
  ) : kind === "checkpoint-editable" ? (
    <CheckpointLab client:load locale={locale} editable />
  ) : kind === "sensor" ? (
    <SensorLab client:load locale={locale} />
  ) : (
    <TrafficLab client:load locale={locale} />
  )}
</div>
