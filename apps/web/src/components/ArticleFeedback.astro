---
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
  contentId: string;
}

const { locale, contentId } = Astro.props;
const enabled = import.meta.env.PUBLIC_FEEDBACK_ENABLED === "true";
const apiBase = import.meta.env.PUBLIC_OBSERVABILITY_API_URL?.replace(/\/$/, "") ?? "";
if (enabled && !apiBase) {
  throw new Error("PUBLIC_OBSERVABILITY_API_URL is required when article feedback is enabled.");
}
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const privacyHref = locale === "pt-BR" ? `${base}/pt-br/privacy` : `${base}/privacy`;
const copy = locale === "pt-BR"
  ? {
      heading: "Este artigo foi útil?",
      helpful: "Sim",
      notHelpful: "Não muito",
      reason: "O que mais influenciou sua resposta? (opcional)",
      choose: "Escolha uma opção",
      reasons: {
        clear: "Explicação clara e intuitiva",
        useful_example: "Exemplo útil",
        too_difficult: "Difícil demais",
        too_basic: "Básico demais",
        confusing: "Explicação confusa",
        missing_example: "Faltou um exemplo",
      },
      comment: "Quer acrescentar algo? (opcional)",
      placeholder: "Conte o que ajudou ou o que poderia melhorar.",
      submit: "Enviar resposta",
      privacy: "Não inclua informações pessoais. A resposta é independente da medição e da newsletter.",
      privacyLink: "Detalhes de privacidade",
    }
  : {
      heading: "Was this article useful?",
      helpful: "Yes",
      notHelpful: "Not really",
      reason: "What most influenced your answer? (optional)",
      choose: "Choose one",
      reasons: {
        clear: "Clear and intuitive",
        useful_example: "Useful example",
        too_difficult: "Too difficult",
        too_basic: "Too basic",
        confusing: "Confusing explanation",
        missing_example: "Missing an example",
      },
      comment: "Anything else? (optional)",
      placeholder: "Tell us what helped or what could be better.",
      submit: "Submit feedback",
      privacy: "Do not include personal information. Feedback is independent from measurement and the newsletter.",
      privacyLink: "Privacy details",
    };
---

{enabled && (
  <section
    class="article-feedback"
    data-article-feedback
    data-api-base={apiBase}
    data-content-id={contentId}
    data-locale={locale}
    aria-labelledby="article-feedback-heading"
  >
    <form>
      <fieldset>
        <legend id="article-feedback-heading">{copy.heading}</legend>
        <div class="article-feedback-choices">
          <label data-feedback-choice data-selected="false">
            <input type="radio" name="sentiment" value="helpful" required />
            <span>{copy.helpful}</span>
          </label>
          <label data-feedback-choice data-selected="false">
            <input type="radio" name="sentiment" value="not_helpful" required />
            <span>{copy.notHelpful}</span>
          </label>
        </div>
      </fieldset>
      <div class="article-feedback-details" data-feedback-details hidden>
        <label>
          <span>{copy.reason}</span>
          <select name="reason">
            <option value="">{copy.choose}</option>
            {Object.entries(copy.reasons).map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
        <label>
          <span>{copy.comment}</span>
          <textarea
            name="comment"
            rows="3"
            maxlength="500"
            placeholder={copy.placeholder}
            data-feedback-comment
          ></textarea>
          <small data-feedback-count></small>
        </label>
        <button type="submit" data-feedback-submit>{copy.submit}</button>
        <p class="article-feedback-privacy">{copy.privacy} <a href={privacyHref}>{copy.privacyLink}</a>.</p>
      </div>
      <p class="article-feedback-status" data-feedback-status role="status" aria-live="polite"></p>
    </form>
    <script>
      import { initializeArticleFeedback } from "../scripts/articleFeedback";
      for (const root of document.querySelectorAll<HTMLElement>("[data-article-feedback]")) {
        initializeArticleFeedback({
          root,
          apiBase: root.dataset.apiBase ?? "",
          contentId: root.dataset.contentId ?? "",
          locale: root.dataset.locale === "pt-BR" ? "pt-BR" : "en",
        });
      }
    </script>
  </section>
)}

<style>
  .article-feedback {
    width: min(680px, calc(100% - 48px));
    margin: 84px auto 28px;
    border-top: 1px solid var(--border);
    padding-top: 32px;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }
  fieldset { margin: 0; border: 0; padding: 0; }
  legend { color: var(--text); font-size: 1.08rem; font-weight: 800; }
  .article-feedback-choices { display: flex; gap: 10px; margin-top: 16px; }
  .article-feedback-choices label { cursor: pointer; }
  .article-feedback-choices input { position: absolute; opacity: 0; }
  .article-feedback-choices span {
    display: block;
    min-width: 104px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text);
    padding: 11px 18px;
    text-align: center;
    font-size: 0.84rem;
    font-weight: 750;
  }
  .article-feedback-choices label[data-selected="true"] span {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-hover);
  }
  .article-feedback-choices input:focus-visible + span { outline: 3px solid var(--accent-soft); outline-offset: 2px; }
  .article-feedback-details { display: grid; gap: 18px; margin-top: 24px; }
  .article-feedback-details[hidden] { display: none; }
  .article-feedback-details label { display: grid; gap: 8px; color: var(--text); font-size: 0.78rem; font-weight: 700; }
  select, textarea {
    width: 100%;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--surface-raised);
    color: var(--text);
    padding: 11px 12px;
    font: 400 0.9rem/1.5 Inter, ui-sans-serif, system-ui, sans-serif;
  }
  textarea { resize: vertical; }
  select:focus-visible, textarea:focus-visible { outline: 3px solid var(--accent-soft); outline-offset: 2px; }
  small { color: var(--text-muted); font-size: 0.7rem; font-weight: 500; text-align: right; }
  button {
    justify-self: start;
    min-height: 42px;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    padding: 10px 18px;
    font: 800 0.78rem/1 Inter, ui-sans-serif, system-ui, sans-serif;
  }
  button:hover:not(:disabled) { background: var(--accent-hover); }
  button:disabled { cursor: wait; opacity: 0.58; }
  .article-feedback-privacy, .article-feedback-status { margin: 0; color: var(--text-muted); font-size: 0.72rem; line-height: 1.55; }
  .article-feedback-status:not(:empty) { margin-top: 14px; color: var(--accent-hover); font-weight: 700; }
  @media (max-width: 560px) {
    .article-feedback { width: min(100% - 32px, 680px); margin-top: 64px; }
    .article-feedback-choices { display: grid; grid-template-columns: 1fr 1fr; }
    .article-feedback-choices span { min-width: 0; }
    button { width: 100%; }
  }
</style>
