---
import {
  articleHref,
  getArticleConnections,
  type Article,
  type ArticleId,
} from "../content/articles";
import type { Locale } from "../i18n";

interface Props {
  articleId: ArticleId;
  locale?: Locale;
}

const { articleId, locale = "en" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const connections = getArticleConnections(articleId, locale);
const copy = locale === "pt-BR"
  ? {
      eyebrow: "Continue explorando",
      title: "Caminhos pela Aflora",
      readFirst: "Leia antes",
      readFirstDescription: "Ideias que este artigo pressupõe",
      buildFromHere: "Continue daqui",
      buildFromHereDescription: "Artigos que usam este como base",
      exploreNearby: "Explore por perto",
      exploreNearbyDescription: "Ideias relacionadas que não são pré-requisitos",
    }
  : {
      eyebrow: "Keep exploring",
      title: "Paths through Aflora",
      readFirst: "Read first",
      readFirstDescription: "Ideas this article expects you to know",
      buildFromHere: "Build from here",
      buildFromHereDescription: "Articles that use this one as a foundation",
      exploreNearby: "Explore nearby",
      exploreNearbyDescription: "Related ideas that are not required next steps",
    };

const groups: Array<{
  label: string;
  description: string;
  articles: Article[];
}> = [
  {
    label: copy.readFirst,
    description: copy.readFirstDescription,
    articles: connections.prerequisites,
  },
  {
    label: copy.buildFromHere,
    description: copy.buildFromHereDescription,
    articles: connections.buildsFromHere,
  },
  {
    label: copy.exploreNearby,
    description: copy.exploreNearbyDescription,
    articles: connections.related,
  },
].filter((group) => group.articles.length > 0);
---

{groups.length > 0 && (
  <nav class="article-connections" aria-labelledby="article-connections-title">
    <div class="article-connections-heading">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="article-connections-title">{copy.title}</h2>
    </div>
    <div class="article-connection-groups">
      {groups.map((group) => (
        <section>
          <h3>{group.label}</h3>
          <p>{group.description}</p>
          <ul>
            {group.articles.map((article) => (
              <li>
                <a href={articleHref(article.id, undefined, base, locale)}>
                  <span>{article.title}</span>
                  <small>{article.topic}</small>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </nav>
)}
