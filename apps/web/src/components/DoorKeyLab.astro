---
import { DoorKeyPlayground } from "@grove/tree-visuals";

interface Props {
  locale?: "en" | "pt-BR";
  mode: "position" | "memory";
}

const { mode, locale = "en" } = Astro.props;
---

<div data-analytics-lab={`markov-door-${mode}`}>
  <DoorKeyPlayground mode={mode} locale={locale} client:load />
</div>
