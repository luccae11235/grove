---
import {
  SyntheticAutocorrelationPlayground,
  SyntheticPartialAutocorrelationPlayground,
  SyntheticSeriesBuilder,
} from "@grove/tree-visuals";

interface Props {
  mode: "builder" | "autocorrelation" | "partial-autocorrelation";
  locale?: "en" | "pt-BR";
}

const { mode, locale = "en" } = Astro.props;
---

<div data-analytics-lab={`synthetic-ar1-${mode}`}>
  {mode === "builder"
    ? <SyntheticSeriesBuilder client:load locale={locale} />
    : mode === "autocorrelation"
      ? <SyntheticAutocorrelationPlayground client:load locale={locale} />
      : <SyntheticPartialAutocorrelationPlayground client:load locale={locale} />}
</div>
