---
import {
  MultiFeatureRegressionPlayground,
  RegressionSplitPlayground,
  RegressionTreeGrowthPlayground,
} from "@grove/tree-visuals";

interface Props {
  kind: "split" | "growth" | "features";
  locale?: "en" | "pt-BR";
}

const { kind, locale = "en" } = Astro.props;
---

<div data-analytics-lab={`regression-${kind}`}>
  {kind === "split" ? (
    <RegressionSplitPlayground locale={locale} client:load />
  ) : kind === "features" ? (
    <MultiFeatureRegressionPlayground locale={locale} client:load />
  ) : (
    <RegressionTreeGrowthPlayground locale={locale} client:load />
  )}
</div>
