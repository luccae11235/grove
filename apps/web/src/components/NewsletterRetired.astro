---
import type { Locale } from "../i18n";
interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;
const pt = locale === "pt-BR";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const prefix = pt ? "/pt-br" : "";
---
<header class="page-header newsletter-confirmation" data-newsletter-retired>
  <p class="eyebrow">Aflora</p>
  <h1>{pt ? "A Aflora continua nos artigos." : "Aflora continues in the articles."}</h1>
  <p class="lede">{pt ? "A newsletter por e-mail foi desativada. Esta página não confirma nem altera inscrições. Os artigos e experimentos continuam gratuitos, aqui no site." : "The email newsletter has been retired. This page does not confirm or change subscriptions. Articles and experiments remain free, here on the website."}</p>
  <p><a class="button-link" href={`${base}${prefix}/${pt ? "artigos" : "articles"}/`}>{pt ? "Explorar os artigos" : "Explore the articles"} →</a></p>
  <p><a href={`${base}${prefix}/privacy/`}>{pt ? "Privacidade e dados de inscrições anteriores" : "Privacy and previous subscription data"}</a></p>
</header>
