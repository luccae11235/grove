---
import { MarkovCheckpointPlayground } from "@grove/tree-visuals";

interface Props {
  locale?: "en" | "pt-BR";
  mode: "position" | "progress";
}

const { mode, locale = "en" } = Astro.props;
---

<div data-analytics-lab={`markov-checkpoint-${mode}`}>
  <MarkovCheckpointPlayground mode={mode} locale={locale} client:load />
</div>
