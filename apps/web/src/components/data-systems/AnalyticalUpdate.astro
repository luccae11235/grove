<section class="data-systems-visual update-visual" id="ds-analytical-update" aria-label="Quando o cancelamento chega ao relatório?">
  <h4 class="scene-question">Quando o cancelamento chega ao relatório?</h4>
  <div class="controls" role="group" aria-label="Momento da atualização">
    <button type="button" data-step="0" aria-pressed="true">1. Antes</button>
    <button type="button" data-step="1" aria-pressed="false">2. Cancelar</button>
    <button type="button" data-step="2" aria-pressed="false">3. Atualizar relatório</button>
  </div>
  <figure aria-describedby="ds-update-update-caption">
    <div class="flow" data-pending="false">
      <section class="record-state" aria-labelledby="ds-update-origin-heading">
        <p class="state-heading" id="ds-update-origin-heading">Origem</p><p>Reserva 104</p><p class="value" id="ds-update-origin-state">confirmada</p>
      </section>
      <section class="propagation" aria-labelledby="ds-update-update-heading">
        <p class="state-heading" id="ds-update-update-heading">Atualização</p><p id="ds-update-propagation-state">Sem mudança pendente</p>
      </section>
      <section class="record-state" aria-labelledby="ds-update-report-heading">
        <p class="state-heading" id="ds-update-report-heading">Relatório analítico</p><p>Reserva 104</p><p class="value" id="ds-update-report-state">confirmada</p>
      </section>
    </div>
    <p id="ds-update-explanation" role="status" aria-live="polite" aria-atomic="true">A origem e o relatório mostram a reserva confirmada.</p>
    <figcaption id="ds-update-update-caption">O intervalo não tem duração definida neste exemplo. Para prometer a última ferramenta, a operação precisa de informação adequada à confirmação da reserva.</figcaption>
  </figure>
  <noscript><p>Depois do cancelamento, a origem mostra “cancelada” enquanto o relatório ainda mostra “confirmada”. Após a propagação, ambos mostram “cancelada”.</p></noscript>
</section>

<script is:inline>
(() => {
  const root = document.getElementById('ds-analytical-update');
  if (!root) return;
  const byId = (id) => root.querySelector('#ds-update-' + id);
  const states = [
    { origin: 'confirmada', report: 'confirmada', update: 'Sem mudança pendente', pending: false, explanation: 'A origem e o relatório mostram a reserva confirmada.' },
    { origin: 'cancelada', report: 'confirmada', update: 'Cancelamento pendente', pending: true, explanation: 'O cancelamento já foi registrado na origem. O relatório ainda mostra a versão anterior.' },
    { origin: 'cancelada', report: 'cancelada', update: 'Cancelamento propagado', pending: false, explanation: 'A atualização chegou ao relatório. Ambos mostram a reserva cancelada.' }
  ];
  const buttons = root.querySelectorAll('[data-step]');
  buttons.forEach(button => button.addEventListener('click', () => {
    const state = states[Number(button.dataset.step)];
    byId('origin-state').textContent = state.origin;
    byId('report-state').textContent = state.report;
    byId('propagation-state').textContent = state.update;
    root.querySelector('.flow').dataset.pending = String(state.pending);
    byId('explanation').textContent = state.explanation;
    buttons.forEach(choice => choice.setAttribute('aria-pressed', String(choice === button)));
  }));
})();
</script>

<style>
.update-visual .controls { display:flex; gap:.5rem; flex-wrap:wrap; margin:1rem 0; }
    .update-visual button { min-height:44px; }
    .update-visual button[aria-pressed="true"] { border-color:var(--accent); background:var(--soft); font-weight:700; }
    .update-visual .flow { display:grid; gap:.8rem; margin:1.5rem auto 1rem; max-width:26rem; }
    .update-visual .record-state { border-left:3px solid var(--ink); padding:.4rem 0 .4rem 1rem; }
    .update-visual .state-heading { font-size:1rem; font-weight:500; color:var(--muted); margin:0 0 .4rem; }
    .update-visual .record-state p:not(.state-heading) { margin:.2rem 0; }
    .update-visual .value { font-size:1.35rem; font-weight:700; }
    .update-visual .propagation { margin-left:1rem; display:grid; grid-template-columns:1rem 1fr; column-gap:.7rem; align-items:center; }
    .update-visual .propagation::before { content:'↓'; font-size:1.6rem; grid-row:1 / 3; }
    .update-visual .propagation .state-heading { margin:0; }
    .update-visual #ds-update-propagation-state { margin:.2rem 0; min-height:1.5em; }
    .update-visual [data-pending="true"] #ds-update-propagation-state { font-weight:700; text-decoration:underline; text-underline-offset:.2em; color:var(--warm); }
    .update-visual #ds-update-explanation { min-height:4.5em; margin:1.5rem 0 0; font-weight:600; }
    .update-visual figcaption { border-top:1px solid var(--line); padding-top:1rem; color:var(--muted); font-size:.9rem; }
</style>
