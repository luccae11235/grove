---
import {CategoricalOverview, TargetFreePlayground, SupervisedPlayground, LearnedPlayground, NativePlayground} from '@grove/tree-visuals';
interface Props {kind:'overview'|'target-free'|'supervised'|'learned'|'native'}
const {kind}=Astro.props;
---
<div data-analytics-lab={`categorical-${kind}`} data-categorical-lab={kind}>
 {kind==='overview' && <CategoricalOverview />}
 {kind==='target-free' && <TargetFreePlayground client:visible />}
 {kind==='supervised' && <SupervisedPlayground client:visible />}
 {kind==='learned' && <LearnedPlayground client:visible />}
 {kind==='native' && <NativePlayground client:visible />}
</div>
