---
interface Props {
  title?: string;
}

const { title = "Explore the metrics" } = Astro.props;
const instanceId = `classification-metrics-${Math.random().toString(36).slice(2, 10)}`;
---

<section class="metrics-playground" data-metrics-playground aria-labelledby={`${instanceId}-title`}>
  <div class="playground-heading">
    <div>
      <p class="eyebrow">Interactive playground</p>
      <h3 id={`${instanceId}-title`}>{title}</h3>
    </div>
    <fieldset class="positive-class">
      <legend>Positive class</legend>
      <label><input type="radio" name={`${instanceId}-positive`} value="green" checked /> Green</label>
      <label><input type="radio" name={`${instanceId}-positive`} value="red" /> Red</label>
    </fieldset>
  </div>

  <div class="preset-row" aria-label="Example distributions">
    <span>Try a pattern</span>
    <div>
      <button type="button" data-preset="accuracy">High accuracy, low recall</button>
      <button type="button" data-preset="precision">High precision, low recall</button>
      <button type="button" data-preset="recall">High recall, low precision</button>
      <button type="button" data-preset="balanced">Balanced</button>
      <button type="button" data-preset="mostly-positive">Almost everything positive</button>
      <button type="button" data-preset="mostly-negative">Almost everything negative</button>
    </div>
  </div>

  <div class="lab-body">
  <div class="visual-wrap">
    <svg viewBox="0 0 720 250" role="img" aria-labelledby={`${instanceId}-visual-title ${instanceId}-visual-desc`}>
      <title id={`${instanceId}-visual-title`}>Classification outcomes</title>
      <desc id={`${instanceId}-visual-desc`}>Actual green and red examples grouped by the class predicted by the model.</desc>
      <g class="prediction-region predicted-red" data-circle="red">
        <circle class="prediction-disc" cx="190" cy="110" r="86" />
        <g data-dot-layer="red"></g>
        <text class="prediction-label" x="190" y="222" text-anchor="middle">Predicted red</text>
      </g>
      <g class="prediction-region predicted-green" data-circle="green">
        <circle class="prediction-disc" cx="530" cy="110" r="86" />
        <g data-dot-layer="green"></g>
        <text class="prediction-label" x="530" y="222" text-anchor="middle">Predicted green</text>
      </g>
    </svg>
    <div class="legend" aria-hidden="true">
      <span><i class="green-dot"></i>Actual green</span>
      <span><i class="red-dot"></i>Actual red</span>
    </div>
  </div>

  <div class="edit-panel">
    <p>Build your own distribution</p>
    <div class="input-groups">
      <fieldset>
        <legend>Predicted green</legend>
        <label><span>Actually green <output data-count-value="gg">45</output></span><input data-count="gg" type="range" min="0" max="100" step="1" value="45" /></label>
        <label><span>Actually red <output data-count-value="gr">5</output></span><input data-count="gr" type="range" min="0" max="100" step="1" value="5" /></label>
      </fieldset>
      <fieldset>
        <legend>Predicted red</legend>
        <label><span>Actually green <output data-count-value="rg">5</output></span><input data-count="rg" type="range" min="0" max="100" step="1" value="5" /></label>
        <label><span>Actually red <output data-count-value="rr">45</output></span><input data-count="rr" type="range" min="0" max="100" step="1" value="45" /></label>
      </fieldset>
    </div>
  </div>
  </div>

  <div class="metric-summary">
  <fieldset class="metric-focus">
    <legend>Show how each metric counts</legend>
    <label><input type="radio" name={`${instanceId}-metric`} value="accuracy" checked /> Accuracy</label>
    <label><input type="radio" name={`${instanceId}-metric`} value="precision" /> Precision</label>
    <label><input type="radio" name={`${instanceId}-metric`} value="recall" /> Recall</label>
  </fieldset>

  <div class="metric-cards" aria-hidden="true">
    <article data-metric-card="accuracy">
      <span>Accuracy</span><strong data-metric-value="accuracy">—</strong>
      <div class="fraction"><b data-numerator="accuracy">0</b><i></i><b data-denominator="accuracy">0</b></div>
      <small>correct predictions / all predictions</small>
    </article>
    <article data-metric-card="precision">
      <span>Precision</span><strong data-metric-value="precision">—</strong>
      <div class="fraction"><b data-numerator="precision">0</b><i></i><b data-denominator="precision">0</b></div>
      <small>correct positive predictions / all positive predictions</small>
    </article>
    <article data-metric-card="recall">
      <span>Recall</span><strong data-metric-value="recall">—</strong>
      <div class="fraction"><b data-numerator="recall">0</b><i></i><b data-denominator="recall">0</b></div>
      <small>positives found / all actual positives</small>
    </article>
  </div>
  </div>
  <p class="sr-only" aria-live="polite" data-live-summary></p>
</section>

<script>
  const SVG_NS = "http://www.w3.org/2000/svg";
  const presets: Record<string, [number, number, number, number]> = {
    accuracy: [1, 1, 4, 94],
    precision: [2, 0, 8, 50],
    recall: [10, 30, 0, 50],
    balanced: [45, 5, 5, 45],
    "mostly-positive": [10, 45, 0, 5],
    "mostly-negative": [1, 0, 9, 50],
  };

  document.querySelectorAll<HTMLElement>("[data-metrics-playground]").forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = "true";
    const inputs = Object.fromEntries(
      [...root.querySelectorAll<HTMLInputElement>("[data-count]")].map((input) => [input.dataset.count!, input]),
    ) as Record<"gg" | "gr" | "rg" | "rr", HTMLInputElement>;

    const value = (key: keyof typeof inputs) => {
      const parsed = Math.round(Number(inputs[key].value));
      return Number.isFinite(parsed) ? Math.min(100, Math.max(0, parsed)) : 0;
    };
    const percent = (part: number, total: number) => total ? `${Math.round((part / total) * 100)}%` : "—";

    function dots(layer: Element, green: number, red: number, centerX: number, rotation: number) {
      layer.replaceChildren();
      const classes = Array.from({ length: green + red }, (_, index) =>
        Math.round(((index + 1) * green) / (green + red)) > Math.round((index * green) / (green + red)) ? "green" : "red",
      );
      classes.forEach((actual, index) => {
        const radius = classes.length === 1 ? 0 : 66 * Math.sqrt((index + 0.5) / classes.length);
        const angle = rotation + index * Math.PI * (3 - Math.sqrt(5));
        const dot = document.createElementNS(SVG_NS, "circle");
        dot.setAttribute("cx", String(centerX + Math.cos(angle) * radius));
        dot.setAttribute("cy", String(110 + Math.sin(angle) * radius));
        dot.setAttribute("r", classes.length > 100 ? "3" : "4");
        dot.setAttribute("class", `outcome-dot playground-dot actual-${actual}`);
        dot.dataset.actual = actual;
        dot.dataset.predicted = centerX === 530 ? "green" : "red";
        layer.append(dot);
      });
    }

    function render() {
      (Object.keys(inputs) as Array<keyof typeof inputs>).forEach((key) => {
        inputs[key].value = String(value(key));
        root.querySelector<HTMLOutputElement>(`[data-count-value="${key}"]`)!.value = inputs[key].value;
      });
      const gg = value("gg"), gr = value("gr"), rg = value("rg"), rr = value("rr");
      dots(root.querySelector('[data-dot-layer="green"]')!, gg, gr, 530, 0.35);
      dots(root.querySelector('[data-dot-layer="red"]')!, rg, rr, 190, -0.5);

      const positive = root.querySelector<HTMLInputElement>('[name$="-positive"]:checked')!.value;
      const focus = root.querySelector<HTMLInputElement>('[name$="-metric"]:checked')!.value;
      const truePositive = positive === "green" ? gg : rr;
      const predictedPositive = positive === "green" ? gg + gr : rr + rg;
      const actualPositive = positive === "green" ? gg + rg : rr + gr;
      const accuracyNumerator = gg + rr;
      const total = gg + gr + rg + rr;
      const metrics = {
        accuracy: [accuracyNumerator, total],
        precision: [truePositive, predictedPositive],
        recall: [truePositive, actualPositive],
      } as const;

      root.dataset.focus = focus;
      root.dataset.positive = positive;
      for (const metric of ["accuracy", "precision", "recall"] as const) {
        const [numerator, denominator] = metrics[metric];
        root.querySelector(`[data-metric-value="${metric}"]`)!.textContent = percent(numerator, denominator);
        root.querySelector(`[data-numerator="${metric}"]`)!.textContent = String(numerator);
        root.querySelector(`[data-denominator="${metric}"]`)!.textContent = String(denominator);
        root.querySelector(`[data-metric-card="${metric}"]`)!.classList.toggle("active", focus === metric);
      }
      root.querySelector<HTMLElement>("[data-live-summary]")!.textContent =
        `Positive class ${positive}. Accuracy ${percent(...metrics.accuracy)}. Precision ${percent(...metrics.precision)}. Recall ${percent(...metrics.recall)}.`;
    }

    root.addEventListener("input", render);
    root.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-preset]");
      if (!button) return;
      const preset = presets[button.dataset.preset!];
      [inputs.gg.value, inputs.gr.value, inputs.rg.value, inputs.rr.value] = preset.map(String);
      root.querySelectorAll("[data-preset]").forEach((item) => item.toggleAttribute("aria-pressed", item === button));
      render();
    });
    render();
  });
</script>

<style>
  .metrics-playground {
    --green: var(--accent);
    --green-dark: var(--accent-hover);
    --red: #b44332;
    width: min(720px, 100%);
    margin: 40px auto;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface-raised);
    box-shadow: 0 16px 44px rgb(22 56 43 / 7%);
    overflow: hidden;
    color: var(--text);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }
  .playground-heading, .preset-row, .metric-focus, .metric-cards, .edit-panel { padding-inline: clamp(16px, 3vw, 24px); }
  .playground-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; padding-block: 20px 14px; }
  .eyebrow { margin: 0 0 5px; color: var(--accent); font-size: 11px; font-weight: 750; letter-spacing: .13em; text-transform: uppercase; }
  h3 { margin: 0; font-family: var(--font-display, Georgia, serif); font-size: clamp(24px, 4vw, 32px); }
  fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .positive-class legend, .metric-focus legend { margin-bottom: 7px; color: var(--text-muted); font-size: 12px; font-weight: 700; }
  .positive-class label, .metric-focus label { display: inline-flex; align-items: center; gap: 5px; margin-right: 10px; font-size: 13px; font-weight: 650; }
  input[type="radio"] { accent-color: var(--accent); }
  .preset-row { border-block: 1px solid var(--border); padding-block: 11px; background: var(--surface-subtle); }
  .preset-row > span, .edit-panel > p { display: block; margin: 0 0 7px; font-size: 11px; font-weight: 750; }
  .preset-row > div { display: flex; gap: 7px; overflow-x: auto; padding-bottom: 2px; scrollbar-width: thin; }
  button { flex: 0 0 auto; border: 1px solid var(--border-strong); border-radius: 999px; padding: 7px 10px; background: var(--surface-raised); color: var(--text); font: inherit; font-size: 11px; cursor: pointer; }
  button:hover, button:focus-visible, button[aria-pressed="true"] { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--surface-raised)); }
  .lab-body { display: grid; grid-template-columns: minmax(0, 3fr) minmax(220px, 2fr); align-items: center; }
  .visual-wrap { min-width: 0; padding: 10px 4px 4px; }
  .visual-wrap svg { display: block; width: 100%; height: auto; }
  .prediction-disc { stroke-width: 2; transition: opacity .2s ease, stroke-width .2s ease; }
  .predicted-red .prediction-disc { fill: color-mix(in srgb, var(--red) 3%, var(--surface-raised)); stroke: var(--red); }
  .predicted-green .prediction-disc { fill: color-mix(in srgb, var(--green) 4%, var(--surface-raised)); stroke: var(--green); }
  .prediction-label { font-size: 17px; font-weight: 720; }
  .predicted-red .prediction-label { fill: var(--red); }
  .predicted-green .prediction-label { fill: var(--green-dark); }
  :global(.outcome-dot) { stroke-width: 2; transition: opacity .2s ease, r .2s ease; }
  :global(.outcome-dot.actual-green) { fill: color-mix(in srgb, var(--green) 22%, var(--surface-raised)); stroke: var(--green-dark); }
  :global(.outcome-dot.actual-red) { fill: color-mix(in srgb, var(--red) 5%, var(--surface-raised)); stroke: var(--red); }
  [data-focus="precision"][data-positive="green"] [data-circle="red"], [data-focus="precision"][data-positive="red"] [data-circle="green"] { opacity: .18; }
  [data-focus="recall"][data-positive="green"] :global(.actual-red), [data-focus="recall"][data-positive="red"] :global(.actual-green) { opacity: .16; }
  [data-focus="accuracy"] :global(.actual-red[data-predicted="green"]), [data-focus="accuracy"] :global(.actual-green[data-predicted="red"]) { opacity: .16; }
  .legend { display: flex; justify-content: center; gap: 18px; margin: -3px 0 10px; font-size: 11px; font-weight: 650; }
  .legend span { display: inline-flex; align-items: center; gap: 7px; }
  .legend i { width: 11px; height: 11px; border: 2px solid; border-radius: 50%; }
  .green-dot { border-color: var(--green-dark) !important; background: color-mix(in srgb, var(--green) 22%, var(--surface-raised)); }
  .red-dot { border-color: var(--red) !important; background: color-mix(in srgb, var(--red) 5%, var(--surface-raised)); }
  .metric-summary { border-top: 1px solid var(--border); background: var(--surface-subtle); }
  .metric-focus { padding-block: 10px 7px; text-align: center; }
  .metric-focus legend { margin-bottom: 4px; }
  .metric-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding-bottom: 13px; }
  .metric-cards article { display: grid; grid-template-columns: 1fr auto; gap: 2px 8px; border: 1px solid var(--border); border-radius: 11px; padding: 9px 10px; background: var(--surface-raised); }
  .metric-cards article.active { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .metric-cards span { font-size: 12px; font-weight: 750; }
  .metric-cards strong { color: var(--accent-hover); font-size: 17px; }
  .fraction { display: inline-grid; grid-template-rows: auto 1px auto; justify-items: center; align-self: center; width: 36px; grid-row: 2 / 4; }
  .fraction i { width: 100%; height: 1px; background: currentColor; }
  .fraction b { font-size: 12px; line-height: 17px; }
  .metric-cards small { color: var(--text-muted); font-size: 10px; line-height: 1.35; }
  .edit-panel { align-self: stretch; display: flex; flex-direction: column; justify-content: center; padding-block: 14px; border-left: 1px solid var(--border); background: var(--surface-subtle); }
  .input-groups { display: grid; gap: 13px; }
  .input-groups fieldset { display: grid; gap: 7px; }
  .input-groups legend { margin-bottom: 6px; font-size: 12px; font-weight: 750; }
  .input-groups label { display: grid; gap: 2px; color: var(--text-muted); font-size: 10px; font-weight: 650; }
  .input-groups label span { display: flex; justify-content: space-between; gap: 8px; }
  .input-groups output { color: var(--text); font-variant-numeric: tabular-nums; }
  input[type="range"] { width: 100%; margin: 0; accent-color: var(--accent); cursor: pointer; }
  input:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 600px) {
    .playground-heading { align-items: start; flex-direction: column; }
    .lab-body { grid-template-columns: 1fr; }
    .edit-panel { border-top: 1px solid var(--border); border-left: 0; }
    .input-groups { grid-template-columns: 1fr 1fr; gap: 14px; }
    .metric-cards { grid-template-columns: 1fr; }
    .metric-cards small, .fraction { display: none; }
    .prediction-label { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .prediction-disc, :global(.outcome-dot) { transition: none; }
  }
</style>
