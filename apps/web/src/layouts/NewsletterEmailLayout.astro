---
import type { NewsletterIssue } from "../content/issues";

interface Props {
  issue: NewsletterIssue;
}

const { issue } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = Astro.site ?? Astro.url;
const canonicalUrl = new URL(`${base}${issue.href}`, site);
const ctaUrl = new URL(`${base}${issue.cta.href}`, site);
const postalAddress = import.meta.env.NEWSLETTER_POSTAL_ADDRESS?.trim() || "[POSTAL ADDRESS REQUIRED BEFORE SENDING]";
---

<!doctype html>
<html lang={issue.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{issue.subject}</title>
  </head>
  <body style="margin:0;background:#f7f5ef;color:#19372b;font-family:Arial,Helvetica,sans-serif;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">{issue.preheader}</div>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f7f5ef;padding:28px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:680px;background:#ffffff;border:1px solid #d9ded5;border-radius:18px;overflow:hidden;">
            <tr>
              <td style="padding:34px 40px 20px;border-bottom:1px solid #e5e8e2;">
                <p style="margin:0 0 8px;color:#2f6b4f;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;">Grove · Issue {String(issue.issueNumber).padStart(3, "0")}</p>
                <p style="margin:0;color:#52635b;font-size:15px;">Ideas, made interactive.</p>
              </td>
            </tr>
            <tr>
              <td class="issue-body" style="padding:34px 40px;font-family:Georgia,'Times New Roman',serif;font-size:18px;line-height:1.7;color:#263c33;">
                <slot />
                <p style="margin:34px 0 10px;">
                  <a href={ctaUrl} style="display:inline-block;border-radius:999px;background:#2f6b4f;color:#ffffff;padding:14px 22px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:700;text-decoration:none;">{issue.cta.label} →</a>
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:24px 40px;background:#f3f5f1;color:#64736c;font-size:12px;line-height:1.6;">
                <p style="margin:0 0 8px;">You received this because you confirmed a subscription to Grove.</p>
                <p style="margin:0 0 8px;"><a href={canonicalUrl} style="color:#2f6b4f;">Read this issue on the web</a> · <a href="{{{RESEND_UNSUBSCRIBE_URL}}}" style="color:#2f6b4f;">Unsubscribe or change preferences</a></p>
                <p style="margin:0;">{postalAddress}</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

<style is:global>
  .issue-body p { margin: 0 0 20px; }
  .issue-body strong { color: #19372b; }
  @media (max-width: 560px) {
    .issue-body { padding: 28px 22px !important; }
    td { word-break: normal; }
  }
</style>
