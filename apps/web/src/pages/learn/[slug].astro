---
import { getCollection, render, type CollectionEntry } from "astro:content";
import "katex/dist/katex.min.css";
import ArticleConnections from "../../components/ArticleConnections.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { articles } from "../../content/articles";
import BaseLayout from "../../layouts/BaseLayout.astro";

type ArticleEntry = CollectionEntry<"articles">;

export async function getStaticPaths() {
  const genericMdxArticleIds = new Set([
    "reward-hacking-three-mdps",
    "bagging-reduces-tree-variance",
    "gradient-boosting-quick-deep-dive",
  ]);
  const includeDrafts =
    import.meta.env.DEV || import.meta.env.SHOW_DRAFTS === "true";

  const entries = await getCollection(
    "articles",
    ({ data }) =>
      genericMdxArticleIds.has(data.articleId) &&
      data.locale === "en" &&
      (data.status === "published" || includeDrafts),
  );

  return entries.map((entry) => ({
    params: { slug: entry.data.routeSlug },
    props: { entry },
  }));
}

interface Props {
  entry: ArticleEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const inCatalog = articles.some((article) => article.id === entry.data.articleId);
const newsletterSource = `${entry.data.articleId}-article`;
const translations = entry.data.articleId === "reward-hacking-three-mdps"
  ? { en: "/learn/reward-hacking/", "pt-BR": "/pt-br/learn/reward-hacking/" }
  : undefined;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={entry.data.href}
  translations={translations}
  pageType="article"
  analyticsContentId={entry.data.articleId}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  noindex={entry.data.status === "draft"}
  wide
>
  <Content />
  {inCatalog && <ArticleConnections articleId={entry.data.articleId} />}
  <NewsletterSignup source={newsletterSource} compact />
</BaseLayout>

<style is:global>
  .reward-hacking-article h2,
  .reward-hacking-article h3 {
    scroll-margin-top: 84px;
  }

  .reward-hacking-article .article-visual-placeholder {
    display: grid;
    gap: 6px;
    margin: 32px 0;
    padding: 22px 24px;
    border: 1px dashed var(--border-strong);
    border-radius: 12px;
    background: var(--surface-subtle);
    color: var(--text-muted);
  }

  .reward-hacking-article .article-visual-placeholder strong {
    color: var(--text);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reward-hacking-article .article-visual-placeholder span {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1rem;
    line-height: 1.6;
  }

  .reward-hacking-article .formula > p {
    margin: 0;
    color: inherit;
    font: inherit;
    line-height: 1.65;
  }

  .bagging-article .katex {
    color: var(--text);
    font-size: 1.06em;
  }

  .bagging-article .katex-display {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    margin: 28px 0 32px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 4px 8px;
    text-align: center;
    scrollbar-color: var(--border-strong) transparent;
    scrollbar-width: thin;
  }

  .bagging-article .katex-display > .katex {
    display: inline-block;
    min-width: max-content;
    font-size: clamp(1.03rem, 2.4vw, 1.26rem);
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .bagging-article .katex-display {
      margin-right: -8px;
      margin-left: -8px;
      padding-right: 8px;
      padding-left: 8px;
      text-align: left;
    }
  }
</style>
