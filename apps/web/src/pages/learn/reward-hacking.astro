---
import { getCollection, render } from "astro:content";
import ArticleConnections from "../../components/ArticleConnections.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { articles } from "../../content/articles";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = await getCollection(
  "articles",
  ({ data }) => data.articleId === "reward-hacking-three-mdps" && data.locale === "en",
);
const entry = entries[0];
if (!entry) throw new Error("Missing reward-hacking-three-mdps article entry.");
const { Content } = await render(entry);

// Connections resolve only for articles in the visible catalog (published, or
// any article during local dev). A draft is absent from the production build,
// so we skip the block there rather than let it throw.
const inCatalog = articles.some((article) => article.id === entry.data.articleId);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={entry.data.href}
  pageType="article"
  noindex={entry.data.status === "draft"}
  wide
>
  <Content />
  {inCatalog && <ArticleConnections articleId={entry.data.articleId} />}
  <NewsletterSignup source="reward-hacking-article" compact />
</BaseLayout>
