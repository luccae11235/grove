---
import { getCollection, render } from "astro:content";
import "katex/dist/katex.min.css";
import ArticleConnections from "../../components/ArticleConnections.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { articles } from "../../content/articles";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = await getCollection(
  "articles",
  ({ data }) => data.articleId === "how-the-past-echoes-acf-pacf" && data.locale === "en",
);
const entry = entries[0];
if (!entry) throw new Error("Missing how-the-past-echoes-acf-pacf article entry.");
const inCatalog = articles.some((article) => article.id === entry.data.articleId);
if (!inCatalog) return Astro.redirect("/");

const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={entry.data.href}
  translations={{ en: "/learn/acf-and-pacf/", "pt-BR": "/pt-br/learn/acf-e-pacf/" }}
  pageType="article"
  analyticsContentId={entry.data.articleId}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  noindex={entry.data.status === "draft"}
  wide
>
  <Content />
  {inCatalog && <ArticleConnections articleId={entry.data.articleId} />}
  <NewsletterSignup source="acf-pacf-article" compact />
</BaseLayout>

<style is:global>
  .acf-article > h2:first-child { margin-top: 0; }

  .acf-data-index-figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .acf-series-figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .acf-article .static-figure {
    left: auto;
    width: 100%;
    transform: none;
  }

  .article-interactive.acf-playground-breakout {
    width: min(720px, calc(100vw - 48px));
  }

  .acf-article .katex {
    color: var(--text);
    font-size: 1.08em;
  }

  .acf-article .katex-display {
    display: block;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    margin: 30px 0 34px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    background: var(--surface-subtle);
    overflow-x: auto;
    overflow-y: hidden;
    padding: 26px clamp(18px, 4vw, 34px);
    text-align: center;
    scrollbar-color: var(--border-strong) transparent;
    scrollbar-width: thin;
  }

  .acf-article .katex-display > .katex {
    display: inline-block;
    min-width: max-content;
    font-size: clamp(1.08rem, 2.6vw, 1.38rem);
    white-space: nowrap;
  }

  .acf-article .katex-display > .katex > .katex-html {
    padding: 0.05em;
  }

  .draft-placeholder {
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--accent-hover);
    padding: 0.08em 0.32em;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78em;
    font-weight: 700;
    white-space: nowrap;
  }

  .acf-inline-playground {
    margin: 34px 0 38px;
  }

  @media (max-width: 560px) {
    .acf-data-index-figure {
      overflow-x: auto;
      scrollbar-color: var(--border-strong) transparent;
      scrollbar-width: thin;
    }

    .acf-data-index-figure img {
      width: 620px;
      max-width: none;
    }

    .acf-diagnostic-figure {
      overflow-x: auto;
      scrollbar-color: var(--border-strong) transparent;
      scrollbar-width: thin;
    }

    .acf-diagnostic-figure img {
      width: 600px;
      max-width: none;
    }

    .acf-article .katex-display {
      margin-right: -10px;
      margin-left: -10px;
      padding: 22px 16px;
      text-align: left;
    }
  }
</style>
