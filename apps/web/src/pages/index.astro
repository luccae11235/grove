---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import { getAuthoredArticles } from "../content/articles";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const libraryArticles = getAuthoredArticles("en");
const formatDate = (date?: Date) => date?.toLocaleDateString("en", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title="Aflora"
  description="Visual, interactive articles that make machine learning ideas easier to reason about."
  wide
>
  <section class="home-intro">
    <p class="eyebrow">A new interactive publication</p>
    <h1>Machine learning,<br /><em>made tangible.</em></h1>
    <p class="lede">
      Visual essays and small experiments for understanding what models are
      really doing — one difficult idea at a time.
    </p>
    <div class="hero-actions">
      <a class="button-link" href="#articles">Browse all articles <span aria-hidden="true">↓</span></a>
      <a class="quiet-link" href={`${base}/newsletter`}>Get the next article by email</a>
    </div>
    <p class="publication-note"><span aria-hidden="true"></span>Recently planted. New articles are published deliberately.</p>
  </section>

  <section class="article-library" id="articles" aria-labelledby="articles-title">
    <div class="article-library-heading">
      <div>
        <p class="eyebrow">The library</p>
        <h2 id="articles-title">All articles</h2>
      </div>
      <p>{libraryArticles.length} {libraryArticles.length === 1 ? "article" : "articles"}</p>
    </div>

    <div class="article-shelf" tabindex="0" aria-label="All articles">
      {libraryArticles.map((article, index) => (
        <a class="library-card" href={`${base}${article.href}`}>
          <span class="library-card-topline">
            <span class="library-card-topic">{article.topic}</span>
            {article.publishedAt
              ? <span class="library-card-publication">
                  {index === 0 && <span class="library-card-latest">Latest</span>}
                  <time datetime={article.publishedAt.toISOString()}>{formatDate(article.publishedAt)}</time>
                </span>
              : <span class="library-card-status">Draft</span>}
          </span>
          <h3>{article.title}</h3>
          <p>{article.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <NewsletterSignup source="home" />
</BaseLayout>
