---
import { getCollection, render } from "astro:content";
import ArticleConnections from "../../../components/ArticleConnections.astro";
import NewsletterSignup from "../../../components/NewsletterSignup.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const includeDrafts = import.meta.env.DEV || import.meta.env.SHOW_DRAFTS === "true";
const entries = await getCollection(
  "articles",
  ({ data }) =>
    data.articleId === "reward-hacking-three-mdps" &&
    data.locale === "pt-BR" &&
    (data.status === "published" || includeDrafts),
);
const entry = entries[0];
if (!entry) return Astro.redirect("/pt-br/");

const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  locale="pt-BR"
  canonicalPath={entry.data.href}
  translations={{ en: "/learn/reward-hacking/", "pt-BR": "/pt-br/learn/reward-hacking/" }}
  pageType="article"
  analyticsContentId={entry.data.articleId}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  noindex={entry.data.status === "draft"}
  wide
>
  <Content />
  <ArticleConnections articleId={entry.data.articleId} locale="pt-BR" />
  <NewsletterSignup locale="pt-BR" source="reward-hacking-article" compact />
</BaseLayout>

<style is:global>
  .reward-hacking-article h2,
  .reward-hacking-article h3 {
    scroll-margin-top: 84px;
  }

  .reward-hacking-article .formula > p {
    margin: 0;
    color: inherit;
    font: inherit;
    line-height: 1.65;
  }
</style>
