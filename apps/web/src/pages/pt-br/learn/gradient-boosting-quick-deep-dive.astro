---
import { getCollection, render } from "astro:content";
import "katex/dist/katex.min.css";
import ArticleConnections from "../../../components/ArticleConnections.astro";
import NewsletterSignup from "../../../components/NewsletterSignup.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const includeDrafts = import.meta.env.DEV || import.meta.env.SHOW_DRAFTS === "true";
const entries = await getCollection(
  "articles",
  ({ data }) =>
    data.articleId === "gradient-boosting-quick-deep-dive" &&
    data.locale === "pt-BR" &&
    (data.status === "published" || includeDrafts),
);
const entry = entries[0];
if (!entry) return Astro.redirect("/pt-br/");

const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  locale="pt-BR"
  canonicalPath={entry.data.href}
  translations={{ en: "/learn/gradient-boosting-quick-deep-dive/", "pt-BR": "/pt-br/learn/gradient-boosting-quick-deep-dive/" }}
  pageType="article"
  analyticsContentId={entry.data.articleId}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  noindex={entry.data.status === "draft"}
  wide
>
  <Content />
  <ArticleConnections articleId={entry.data.articleId} locale="pt-BR" />
  <NewsletterSignup locale="pt-BR" source="gradient-boosting-quick-deep-dive-article" compact />
</BaseLayout>

<style is:global>
  .gradient-boosting-article .katex {
    color: var(--text);
    font-size: 1.06em;
  }

  .gradient-boosting-article .katex-display {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    margin: 28px 0 32px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 4px 8px;
    text-align: center;
    scrollbar-color: var(--border-strong) transparent;
    scrollbar-width: thin;
  }

  .gradient-boosting-article .katex-display > .katex {
    display: inline-block;
    min-width: max-content;
    font-size: clamp(1.03rem, 2.4vw, 1.26rem);
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .gradient-boosting-article .katex-display {
      margin-right: -8px;
      margin-left: -8px;
      padding-right: 8px;
      padding-left: 8px;
      text-align: left;
    }
  }
</style>
