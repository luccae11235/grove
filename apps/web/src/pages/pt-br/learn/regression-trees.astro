---
import { getCollection, render } from "astro:content";
import ArticleConnections from "../../../components/ArticleConnections.astro";
import NewsletterSignup from "../../../components/NewsletterSignup.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const entries = await getCollection(
  "articles",
  ({ data }) => data.articleId === "regression-trees-from-scratch" && data.locale === "pt-BR",
);
const entry = entries[0];
if (!entry) throw new Error("Missing pt-BR regression-trees-from-scratch article entry.");

const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  locale="pt-BR"
  canonicalPath={entry.data.href}
  translations={{ en: "/learn/regression-trees/", "pt-BR": "/pt-br/learn/regression-trees/" }}
  pageType="article"
  analyticsContentId={entry.data.articleId}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  wide
>
  <Content />
  <ArticleConnections articleId={entry.data.articleId} locale="pt-BR" />
  <NewsletterSignup locale="pt-BR" source="regression-trees-article" compact />
</BaseLayout>

<style is:global>
  .regression-table-figure {
    width: min(720px, calc(100vw - var(--sidebar-width) - 96px));
  }

  .regression-derivation {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .regression-derivation small {
    grid-column: 1 / -1;
    border-top: 1px solid var(--border);
    padding-top: 10px;
    color: var(--text-muted);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.7rem;
    line-height: 1.55;
  }

  .regression-formula {
    overflow-x: auto;
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
    white-space: nowrap;
  }

  .regression-closing {
    padding-bottom: 28px;
  }

  @media (max-width: 900px) {
    .regression-table-figure { width: 100%; }
  }

  @media (max-width: 560px) {
    .regression-derivation { grid-template-columns: 1fr; }
    .regression-derivation strong { margin-bottom: 8px; }
  }
</style>
