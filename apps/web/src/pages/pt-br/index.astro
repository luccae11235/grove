---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { getPublishedArticles } from "../../content/articles";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const libraryArticles = getPublishedArticles("pt-BR");
const formatDate = (date?: Date) => date?.toLocaleDateString("pt-BR", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title="Aflora"
  description="Artigos visuais e interativos que tornam as ideias de aprendizado de máquina mais fáceis de compreender."
  locale="pt-BR"
  translations={{ en: "/", "pt-BR": "/pt-br/" }}
  wide
>
  <section class="home-intro">
    <p class="eyebrow">Uma nova publicação interativa</p>
    <h1>Aprendizado de máquina,<br /><em>de um jeito concreto.</em></h1>
    <p class="lede">
      Ensaios visuais e pequenos experimentos para entender o que os modelos
      realmente fazem — uma ideia difícil de cada vez.
    </p>
    <div class="hero-actions">
      <a class="button-link" href={`${base}/pt-br/artigos`}>Explore os artigos por tema <span aria-hidden="true">→</span></a>
      <a class="quiet-link" href={`${base}/pt-br/newsletter`}>Receba o próximo artigo por e-mail</a>
    </div>
    <p class="publication-note"><span aria-hidden="true"></span>Recém-plantada. Novos artigos são publicados com cuidado.</p>
  </section>

  <section class="article-library" id="articles" aria-labelledby="articles-title">
    <div class="article-library-heading">
      <div>
        <p class="eyebrow">A biblioteca</p>
        <h2 id="articles-title">Todos os artigos</h2>
      </div>
      <p>{libraryArticles.length} {libraryArticles.length === 1 ? "artigo" : "artigos"}</p>
    </div>

    <div class="article-shelf" tabindex="0" aria-label="Todos os artigos">
      {libraryArticles.map((article, index) => (
        <a class="library-card" href={`${base}${article.href}`}>
          <span class="library-card-topline">
            <span class="library-card-topic">{article.topic}</span>
            {article.quickRead && <span class="quick-read-badge">Leitura rápida</span>}
            {article.publishedAt && (
              <span class="library-card-publication">
                {index === 0 && <span class="library-card-latest">Mais recente</span>}
                <time datetime={article.publishedAt.toISOString()}>{formatDate(article.publishedAt)}</time>
              </span>
            )}
          </span>
          <h3>{article.title}</h3>
          <p>{article.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <NewsletterSignup locale="pt-BR" source="home" />
</BaseLayout>
